{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "rootDir": "TypeScript",
    "outDir": "SCRIPTS",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["jquery"],
    "noEmitOnError": true
  },
  "include": ["TypeScript/**/*.ts"]
}
